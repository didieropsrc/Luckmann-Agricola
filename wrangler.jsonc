{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "luckmann-agricola",
  // Worker con API (pedidos, panel admin, sugerencias) + SSR para SEO.
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-30",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Estas rutas pasan primero por el Worker (HTML con SEO renderizado en el servidor,
    // API e imágenes). Todo lo demás (JS, CSS, imágenes estáticas) se sirve directo.
    "run_worker_first": ["/", "/categoria/*", "/producto/*", "/api/*", "/img/*", "/sitemap.xml"]
  },
  "routes": [
    { "pattern": "agro.luckmann.casa", "custom_domain": true }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "luckmann-agricola-db",
      // `npm run setup` reemplaza este valor automáticamente.
      "database_id": "REEMPLAZAR_CON_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "SITE_URL": "https://agro.luckmann.casa",
    "WHATSAPP_NUMBER": "595983790927",
    // Clave pública de Cloudflare Turnstile (antibots). La de abajo es la clave de
    // PRUEBA de Cloudflare: reemplazala por la tuya (ver README).
    "TURNSTILE_SITE_KEY": "1x00000000000000000000AA"
  },
  "observability": { "enabled": true }
}
